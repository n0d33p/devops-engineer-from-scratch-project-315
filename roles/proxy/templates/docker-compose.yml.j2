services:
  caddy:
    image: caddy:2-alpine
    container_name: caddy
    restart: unless-stopped
    # host networking: simplest way for Caddy to reach the app on
    # 127.0.0.1:{{ app_http_port }} without setting up a shared docker network
    # between two separate compose projects
    network_mode: host
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - "{{ proxy_deploy_dir }}/data:/data"
      - "{{ proxy_deploy_dir }}/config:/config"
