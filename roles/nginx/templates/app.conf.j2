server {
	listen 80;
	server_name {{ app_domain }};

	# required for certbot's webroot HTTP-01 challenge, kept even after
	# HTTPS is live so certificate renewal keeps working unattended
	location /.well-known/acme-challenge/ {
		root /var/www/certbot;
	}

{% if cert_exists %}
	# certificate exists - everything else on plain HTTP redirects to HTTPS
	location / {
		return 301 https://$host$request_uri;
	}
}

server {
	listen 443 ssl;
	server_name {{ app_domain }};

	ssl_certificate     /etc/letsencrypt/live/{{ app_domain }}/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/{{ app_domain }}/privkey.pem;
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
	ssl_prefer_server_ciphers off;
	ssl_session_cache shared:SSL:10m;
	ssl_session_timeout 1d;

	add_header Strict-Transport-Security "max-age=63072000" always;
	# static assets (the React Admin build embedded in the app's own
	# static resources) - cache aggressively, they're fingerprinted by
	# the frontend build so a new deploy gets new filenames anyway
	location ~* \.(?:css|js|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
		proxy_pass http://127.0.0.1:{{ app_http_port }};
		proxy_set_header Host $host;
		expires 30d;
		add_header Cache-Control "public, immutable";
	}

	location / {
		proxy_pass http://127.0.0.1:{{ app_http_port }};
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}
}
{% else %}
	# no certificate yet - proxy everything over plain HTTP so certbot
	# has something to validate against; re-run the playbook once the
	# certificate is issued to switch this file to the HTTPS block above
	location / {
		proxy_pass http://127.0.0.1:{{ app_http_port }};
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}
}
{% endif %}
